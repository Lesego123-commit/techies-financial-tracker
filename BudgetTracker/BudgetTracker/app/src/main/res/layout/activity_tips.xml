<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout for the Budgeting Tips screen (own feature).
  Shows a featured "Tip of the day" with a button to shuffle to a new random tip, plus a
  scrollable list of all the budgeting tips grouped by topic.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Featured tip card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 TIP OF THE DAY"
                    android:textColor="#EEFFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvFeaturedTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRandomTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New Tip"
                    android:textColor="@color/primary"
                    app:backgroundTint="@android:color/white"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse all tips"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <!-- Tips are added to this container programmatically -->
        <LinearLayout
            android:id="@+id/llTipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>

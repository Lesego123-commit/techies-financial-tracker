<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground for the Techies Financial Tracker app.
  A gold coin with a bold upward arrow, symbolising positive financial growth (per the design doc).
  Content is kept within the central safe zone of the 108x108 adaptive icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Coin outer ring (darker gold) -->
    <path
        android:fillColor="#FFA000"
        android:pathData="M22,56 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0z" />

    <!-- Coin face (gold) -->
    <path
        android:fillColor="#FFC107"
        android:pathData="M27,56 a27,27 0 1,0 54,0 a27,27 0 1,0 -54,0z" />

    <!-- Upward growth arrow (white) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,38 L38,57 L47,57 L47,76 L61,76 L61,57 L70,57 Z" />
</vector>

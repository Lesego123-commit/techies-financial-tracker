<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background for the Techies Financial Tracker app.
  A diagonal teal-to-green gradient, matching the dual-colour brand described in the design doc.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF26C6DA"
                android:endColor="#FF1B5E20" />
        </aapt:attr>
    </path>
</vector>
